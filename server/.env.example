PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Anggun123
DB_NAME=inventaris_unp

# Isi dengan string acak panjang, contoh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=kelompok_4_inventaris_unp_2026_secret_key
JWT_EXPIRES_IN=8h

CLIENT_URL=http://localhost:5173

# Konfigurasi Google OAuth 2.0 (Google Cloud Console)
# Dapatkan Client ID dari Google Cloud Console:
# 1. Buka https://console.cloud.google.com/apis/credentials
# 2. Buat OAuth 2.0 Client ID (Web Application)
# 3. Masukkan Authorized JavaScript Origins: http://localhost:5173
# 4. Masukkan Authorized redirect URIs: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Set true jika ingin pendaftaran Google langsung aktif (langsung login sebagai Peminjam) tanpa menunggu persetujuan Tendik
AUTO_APPROVE_GOOGLE=false
